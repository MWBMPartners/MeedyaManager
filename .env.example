# ============================================================================
# File: /.env.example
# (C) 2025-2026 MWBM Partners Ltd
#
# Description:
# Example .env file to be copied and renamed to `.env` for development.
# Stores fallback API keys and environment-specific overrides.
# This file is excluded via .gitignore and is not tracked.
#
# Credential priority chain (crates/mm-providers/src/credentials.rs):
#   1. `MM_<PROVIDER>_<KEY>` environment variable (this file)
#   2. In-memory config map, from settings.json5
#   3. OS keyring (service `meedyamanager.<provider>`)
#   4. Local `credentials.json` in the config directory (plain JSON, not
#      encrypted — do not rely on it for anything you wouldn't put in
#      settings.json5)
#
# IMPORTANT — current wiring status (2026-09): `meedya lookup` is still a
# stub (it prints "coming in M5" and does not call any provider). The five
# variables below ARE read into `mm_core::config::AppConfig` at startup
# (crates/mm-core/src/config/mod.rs:465-492) and DO drive the "enabled but
# no credential configured" warnings there — but no CLI/GUI command yet
# constructs a provider with those values, so setting them has no visible
# effect on a lookup today. Only `MM_` names are read; anything else is a
# no-op.
# ============================================================================

# ── MusicBrainz (no API key — User-Agent contact address only) ──
# Read at RUNTIME (not baked into the binary) by
# mm_core::useragent::contact_string(). Overrides the compiled-in default
# ("support@mwbmpartners.ltd https://www.mwbmpartners.ltd") without a
# rebuild — handy for self-hosters who want MusicBrainz to contact them
# directly if traffic ever misbehaves. Deliberately NOT `MM_`-prefixed —
# this is the one exception, matching the upstream User-Agent convention.
# Leave unset to use the compiled-in MWBM Partners Ltd default.
MUSICBRAINZ_CONTACT_EMAIL=            # e.g. you@example.com

# ── Discogs (personal access token) ──
# Read by crates/mm-core/src/config/mod.rs:466 into
# `ProviderConfig::discogs_token`.
MM_DISCOGS_TOKEN=                     # From Discogs Developer Settings

# ── Spotify (OAuth2 Client Credentials) ──
# Read by crates/mm-core/src/config/mod.rs:472,478.
MM_SPOTIFY_CLIENT_ID=                 # From Spotify Developer Dashboard
MM_SPOTIFY_CLIENT_SECRET=             # From Spotify Developer Dashboard

# ── TMDb (The Movie Database) ──
# Read by crates/mm-core/src/config/mod.rs:484.
MM_TMDB_API_KEY=                      # From themoviedb.org account settings

# ── AcoustID (audio fingerprint lookups) ──
# Read by crates/mm-core/src/config/mod.rs:490.
MM_ACOUSTID_API_KEY=                  # From acoustid.org account settings

# ── Other providers with real implementations but no config wiring yet ──
# `crates/mm-providers` has working HTTP clients for Apple Music (iTunes
# Search API — no key), Deezer (public API — no key), Apple TV / iTunes
# Store / Apple Podcasts (iTunes Search API — no key), TheTVDB, OMDb and
# EIDR. None of these are reachable from `settings.json5` or from an env
# var yet: there is no `ProviderConfig` field for them and no call site
# constructs them with a credential. If you need TheTVDB/OMDb/EIDR
# credentials before that wiring lands, pass them directly to the
# relevant `*Provider::new(...)` constructor in your own code.
#
# Provider IDs beyond the ones above (YouTube Music, Amazon Music,
# Pandora, Tidal, Shazam, iHeart) exist only as placeholder strings in the
# rate limiter and the GTK UI ("*" = planned) — there is no provider
# implementation for them at all yet, so there is nothing to configure.

# ── Non-secret runtime overrides (crates/mm-core/src/config/mod.rs) ──
# These override settings.json5 values; none are provider credentials.
MM_LOG_LEVEL=info                     # trace|debug|info|warn|error
MM_DRY_RUN=false                      # true = preview renames, never write
MM_TEST_MODE=false                    # intended to force dry-run edits;
                                       # NOT currently enforced end-to-end,
                                       # see issue #128 — do not rely on it
                                       # for safety in production use
