# Enforce consistent line endings across platforms

# Default: auto-detect (respects .editorconfig / per-file overrides below)
* text=auto

# Rust source files — always LF (required by rustfmt newline_style = "Unix")
*.rs text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.json5 text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sh text eol=lf

# Swift source files
*.swift text eol=lf

# C# / Windows project files — keep CRLF for Visual Studio compatibility
*.cs text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.appxmanifest text eol=crlf
*.xaml text eol=crlf

# Binary files — never touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.dll binary
*.dylib binary
*.so binary
*.a binary
*.xcframework binary

# MWBM-MEDIA-LANG policy copies must stay byte-for-byte identical to the
# master files in MWBMPartners/MeedyaSuite-core (the policy document says so
# itself, in docs/standards/media-language-bcp47-policy.md, section 8.3). The
# generic rules above would still be free to convert their line endings on a
# checkout, and the copy checker (scripts/media-lang/check_copies.py) would
# then report every one of them as "changed" even though nobody touched a
# single character — so each one is marked "-text" here, overriding those
# generic rules, to say plainly that git must never rewrite them.
docs/standards/media-language-bcp47-policy.md -text
docs/standards/MWBM-MEDIA-LANG.lock -text
tests/fixtures/bcp47-language-policy-v1.json -text
tests/fixtures/bcp47-language-policy-v1.schema.json -text
docs/standards/data/bcp47-language-data-v1.json -text
docs/standards/data/bcp47-language-data-v1.schema.json -text
scripts/media-lang/check_copies.py -text
